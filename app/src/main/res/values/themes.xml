<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal launch theme so the manifest resolves. The full premium
     light/dark palette + Playfair Display / Inter typography arrive in Step 4. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Haven.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
</resources>
