   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Film - Cinematic Teal &amp; Orange</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cinematic T&amp;O</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Film Look</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Moody cinema teal-and-orange grade: cool teal shadows, warm orange skin, crushed-but-lifted blacks. Great for portraits, street and video.</rdf:li>
    </rdf:Alt>
   </crs:Description>
   <crs:ToneCurvePV2012>
