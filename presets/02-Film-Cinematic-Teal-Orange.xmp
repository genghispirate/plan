   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Moody cinema teal-and-orange grade: cool teal shadows, warm orange skin, lifted blacks. Great for portraits, street and video.</rdf:li>
    </rdf:Alt>
   </crs:Description>
