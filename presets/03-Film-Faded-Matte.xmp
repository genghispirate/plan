   <crs:Name>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Film - Faded Matte</rdf:li>
    </rdf:Alt>
   </crs:Name>
   <crs:ShortName>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Faded Matte</rdf:li>
    </rdf:Alt>
   </crs:ShortName>
   <crs:Group>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Film Look</rdf:li>
    </rdf:Alt>
   </crs:Group>
   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Dreamy low-contrast matte film: heavily lifted blacks, soft pastel colors, faded highlights. Ideal for travel, lifestyle and golden-hour scenes.</rdf:li>
    </rdf:Alt>
   </crs:Description>
