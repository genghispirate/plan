   <crs:Description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Classic Tri-X style black &amp; white film: rich contrast, bright skin, dark dramatic skies, punchy grain and a whisper of selenium tone.</rdf:li>
    </rdf:Alt>
   </crs:Description>
